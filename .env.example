# ── Database ─────────────────────────────────────────────
# Neon Postgres connection string (Vercel → Storage → Neon adds it automatically).
# Leave empty locally: `npm run dev` then uses an embedded database in ./.data
DATABASE_URL=

# ── Staff area (/staff) ──────────────────────────────────
# Long random string used to sign staff logins and game tickets.
SESSION_SECRET=
# Managers (both branches):
STAFF_PASSWORD=
# Optional per-branch passwords (staff only see their branch):
STAFF_PASSWORD_NACCACHE=
STAFF_PASSWORD_FAQRA=
# Locally, when none are set, the password is: saltfish-dev

# ── Salty, the AI host ───────────────────────────────────
# Set one or more. Salty tries them in this order and moves on when a model is busy, stalled, out of quota or rejected.
# Without any, Salty answers in demo mode.
# 1. Gemini, free: Google AI Studio (aistudio.google.com → Get API key, no card needed).
GEMINI_API_KEY=
# Optional: Gemini models to try, in order (default gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash)
GEMINI_MODELS=
# 2. Groq, free backup: console.groq.com → API Keys (no card needed). Its free limits are small for Salty's long
#    menu prompt (about 1 message a minute), so it works best as the backup when Gemini is busy.
GROQ_API_KEY=
# Optional: Groq models to try, in order (default openai/gpt-oss-120b,openai/gpt-oss-20b)
GROQ_MODELS=
# 3. Claude, paid: Claude Console (console.anthropic.com → API keys), with a monthly spend limit.
ANTHROPIC_API_KEY=
# Optional: Claude model (default claude-haiku-5-5)
SALTY_CLAUDE_MODEL=
# 4. Any other OpenAI-compatible service (OpenRouter…): set all three. SALTY_MODEL can list several models.
AI_API_KEY=
AI_BASE_URL=
SALTY_MODEL=
# Optional: max Salty messages per day for the whole site (cost guard, default 3000)
SALTY_DAILY_LIMIT=
