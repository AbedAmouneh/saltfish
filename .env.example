# ── Database ─────────────────────────────────────────────
# Neon Postgres connection string (Vercel → Storage → Neon adds it automatically).
# Leave empty locally: `npm run dev` then uses an embedded database in ./.data
DATABASE_URL=

# ── Staff area (/staff) ──────────────────────────────────
# Long random string used to sign staff logins and game tickets.
SESSION_SECRET=
# Managers (both branches):
STAFF_PASSWORD=
# Optional per-branch passwords (staff only see their branch):
STAFF_PASSWORD_NACCACHE=
STAFF_PASSWORD_FAQRA=
# Locally, when none are set, the password is: saltfish-dev

# ── Salty, the AI host ───────────────────────────────────
# Set ONE of these. Without any, Salty answers in demo mode.
# Free option: a Gemini key from Google AI Studio (aistudio.google.com → Get API key, no card needed).
GEMINI_API_KEY=
# Or Claude, from the Claude Console (console.anthropic.com → API keys). Used first when set.
ANTHROPIC_API_KEY=
# Or any OpenAI-compatible service (Groq, OpenRouter…): set all three of AI_API_KEY, AI_BASE_URL and SALTY_MODEL.
AI_API_KEY=
AI_BASE_URL=
# Optional: override the model (defaults: claude-haiku-5-5 for Claude; for Gemini a fallback list,
# gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash, tried in order when a model is busy or out of quota)
SALTY_MODEL=
# Optional: max Salty messages per day for the whole site (cost guard, default 3000)
SALTY_DAILY_LIMIT=
