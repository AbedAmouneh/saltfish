{
  "name": "saltfish-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Saltfish — Mediterrasian restaurant & hand roll counter. Website (React 19 + React Router 7 + TypeScript, deployed on Vercel).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/@react-router/dev/bin.js dev",
    "build": "react-router build",
    "start": "node --env-file-if-exists=.env node_modules/@react-router/serve/bin.js ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "content:check": "tsx scripts/check-content.ts",
    "images": "node scripts/images.mjs",
    "og": "tsx scripts/og.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/noto-kufi-arabic": "5.3.0",
    "@fontsource/big-shoulders-display": "5.3.0",
    "@neondatabase/serverless": "1.2.0",
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "@vercel/react-router": "1.3.7",
    "drizzle-orm": "0.45.4",
    "isbot": "5.2.2",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@react-router/dev": "7.18.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-tsconfig-paths": "5.1.4"
  }
}
